datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum HouseholdRole {
  PRIMARY_FILER
  CO_FILER
  VIEWER
}

enum MembershipStatus {
  PENDING_INVITATION
  ACTIVE
  REMOVED
}

enum WorkspaceStatus {
  DRAFT
  COLLECTING
  NEEDS_REVIEW
  READY_TO_CALCULATE
  CALCULATED
  HOUSEHOLD_REVIEW
  APPROVED
  FILING_PACKAGE_READY
  FILED
  ASSESSED
  CLOSED
}

enum AuditEventType {
  USER_REGISTERED
  USER_LOGGED_IN
  USER_LOGGED_OUT
  HOUSEHOLD_CREATED
  MEMBER_INVITED
  MEMBER_JOINED
  MEMBER_REMOVED
  WORKSPACE_INITIALIZED
  FACT_CREATED
  FACT_CONFIRMED
  FACT_UPDATED
  RETURN_APPROVED
  APPROVAL_INVALIDATED
}

enum TaxResidence {
  RESIDENT
  NON_RESIDENT
}

enum TaxClass {
  CLASS_1
  CLASS_1A
  CLASS_2
}

model User {
  id               String                @id @default(uuid()) @db.Uuid
  email            String                @unique
  passwordHash     String
  isEmailVerified  Boolean               @default(false)
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  profile          PersonProfile?
  memberships      HouseholdMembership[]
  createdHouseholds Household[]         @relation("HouseholdCreator")
  sentInvitations  HouseholdInvitation[] @relation("Inviter")
  sessions         Session[]
  auditEvents      AuditEvent[]          @relation("UserAuditEvents")

  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PersonProfile {
  id                 String       @id @default(uuid()) @db.Uuid
  userId             String       @unique @db.Uuid
  firstName          String?
  lastName           String?
  dateOfBirth        DateTime?
  matriculeEncrypted String?
  taxResidence       TaxResidence @default(RESIDENT)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("person_profiles")
}

model Household {
  id          String                @id @default(uuid()) @db.Uuid
  name        String
  slug        String                @unique
  createdById String                @db.Uuid
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  createdBy   User                  @relation("HouseholdCreator", fields: [createdById], references: [id])
  members     HouseholdMembership[]
  invitations HouseholdInvitation[]
  dependants  Dependant[]
  workspaces  TaxYearWorkspace[]
  auditEvents AuditEvent[]

  @@map("households")
}

model HouseholdMembership {
  id          String           @id @default(uuid()) @db.Uuid
  householdId String           @db.Uuid
  userId      String           @db.Uuid
  role        HouseholdRole    @default(CO_FILER)
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
  @@map("household_memberships")
}

model HouseholdInvitation {
  id           String        @id @default(uuid()) @db.Uuid
  householdId  String        @db.Uuid
  invitedEmail String
  invitedRole  HouseholdRole @default(CO_FILER)
  tokenHash    String        @unique
  invitedById  String        @db.Uuid
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime      @default(now())

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedBy    User          @relation("Inviter", fields: [invitedById], references: [id])

  @@index([householdId])
  @@index([invitedEmail])
  @@map("household_invitations")
}

model Dependant {
  id               String    @id @default(uuid()) @db.Uuid
  householdId      String    @db.Uuid
  firstName        String
  lastName         String
  dateOfBirth      DateTime
  relationshipType String    @default("CHILD")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  household        Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("dependants")
}

model TaxYearWorkspace {
  id                  String          @id @default(uuid()) @db.Uuid
  householdId         String          @db.Uuid
  taxYear             Int
  status              WorkspaceStatus @default(DRAFT)
  completionScore     Int             @default(0)
  activeReturnVersion Int             @default(1)
  residenceStatus     TaxResidence    @default(RESIDENT)
  taxClass            TaxClass?
  estimatedTaxBalance Decimal?        @db.Decimal(12, 2)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  household           Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  auditEvents         AuditEvent[]

  @@unique([householdId, taxYear])
  @@index([householdId])
  @@map("tax_year_workspaces")
}

model AuditEvent {
  id            String          @id @default(uuid()) @db.Uuid
  householdId   String?         @db.Uuid
  workspaceId   String?         @db.Uuid
  actorId       String          @db.Uuid
  actorEmail    String?
  eventType     AuditEventType
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?
  description   String
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime        @default(now())

  actor         User            @relation("UserAuditEvents", fields: [actorId], references: [id])
  household     Household?      @relation(fields: [householdId], references: [id], onDelete: SetNull)
  workspace     TaxYearWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([householdId, createdAt])
  @@index([actorId])
  @@map("audit_events")
}
