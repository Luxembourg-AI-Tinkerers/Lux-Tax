datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum HouseholdRole {
  PRIMARY_FILER
  CO_FILER
  VIEWER
}

enum MembershipStatus {
  PENDING_INVITATION
  ACTIVE
  REMOVED
}

enum WorkspaceStatus {
  DRAFT
  COLLECTING
  NEEDS_REVIEW
  READY_TO_CALCULATE
  CALCULATED
  HOUSEHOLD_REVIEW
  APPROVED
  FILING_PACKAGE_READY
  FILED
  ASSESSED
  CLOSED
}

enum AuditEventType {
  USER_REGISTERED
  USER_LOGGED_IN
  USER_LOGGED_OUT
  HOUSEHOLD_CREATED
  MEMBER_INVITED
  MEMBER_JOINED
  MEMBER_REMOVED
  WORKSPACE_INITIALIZED
  DOCUMENT_UPLOADED
  DOCUMENT_DELETED
  FACT_CREATED
  FACT_CONFIRMED
  FACT_UPDATED
  TAX_CALCULATED
  RETURN_APPROVED
  APPROVAL_INVALIDATED
  FILING_PACKAGE_GENERATED
  ASSESSMENT_IMPORTED
}

enum TaxResidence {
  RESIDENT
  NON_RESIDENT
}

enum TaxClass {
  CLASS_1
  CLASS_1A
  CLASS_2
}

enum DocumentVisibility {
  PRIVATE_DRAFT
  SHARED_FOR_DISCUSSION
  PROPOSED_FOR_RETURN
  INCLUDED_IN_RETURN
  ARCHIVED
}

enum DocumentType {
  SALARY_CERTIFICATE
  PENSION_CERTIFICATE
  MORTGAGE_CERTIFICATE
  INSURANCE_CERTIFICATE
  DONATION_CERTIFICATE
  CHILDCARE_INVOICE
  TAX_ASSESSMENT
  FREELANCE_INVOICE
  BUSINESS_EXPENSE
  PROFIT_AND_LOSS_STATEMENT
  VAT_RETURN
  BUSINESS_TAX_ADVANCE
  FREELANCE_CONTRACT
  UNKNOWN
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  EXTRACTED
  FAILED
  CONFIRMED
}

enum FactCategory {
  EMPLOYMENT_INCOME
  FREELANCE_INCOME
  BUSINESS_EXPENSE
  PENSION_INCOME
  MORTGAGE_DEDUCTION
  INSURANCE_DEDUCTION
  DONATION_DEDUCTION
  CHILDCARE_EXPENSE
  OTHER_DEDUCTION
}

enum TaskSeverity {
  BLOCKER
  WARNING
  INFO
}

enum TaskType {
  MISSING_SALARY_CERTIFICATE
  MISSING_MORTGAGE_CERTIFICATE
  UNCONFIRMED_FACT
  MISSING_SPOUSE_INCOME
  MISSING_RESIDENCE_INFO
  RETURN_APPROVAL_REQUIRED
  MISSING_FREELANCE_DOCUMENT
}

model User {
  id               String                @id @default(uuid()) @db.Uuid
  email            String                @unique
  passwordHash     String
  isEmailVerified  Boolean               @default(false)
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  profile          PersonProfile?
  memberships      HouseholdMembership[]
  createdHouseholds Household[]         @relation("HouseholdCreator")
  sentInvitations  HouseholdInvitation[] @relation("Inviter")
  sessions         Session[]
  auditEvents      AuditEvent[]          @relation("UserAuditEvents")
  documentsUploaded Document[]           @relation("DocumentUploader")
  documentsOwned   Document[]           @relation("DocumentOwner")
  confirmedFacts   ConfirmedFact[]       @relation("FactOwner")
  returnApprovals  ReturnApproval[]      @relation("UserReturnApprovals")
  freelanceProfiles FreelanceBusinessProfile[]

  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PersonProfile {
  id                 String       @id @default(uuid()) @db.Uuid
  userId             String       @unique @db.Uuid
  firstName          String?
  lastName           String?
  dateOfBirth        DateTime?
  matriculeEncrypted String?
  taxResidence       TaxResidence @default(RESIDENT)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("person_profiles")
}

model Household {
  id          String                @id @default(uuid()) @db.Uuid
  name        String
  slug        String                @unique
  createdById String                @db.Uuid
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  createdBy   User                  @relation("HouseholdCreator", fields: [createdById], references: [id])
  members     HouseholdMembership[]
  invitations HouseholdInvitation[]
  dependants  Dependant[]
  workspaces  TaxYearWorkspace[]
  auditEvents AuditEvent[]

  @@map("households")
}

model HouseholdMembership {
  id          String           @id @default(uuid()) @db.Uuid
  householdId String           @db.Uuid
  userId      String           @db.Uuid
  role        HouseholdRole    @default(CO_FILER)
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
  @@map("household_memberships")
}

model HouseholdInvitation {
  id           String        @id @default(uuid()) @db.Uuid
  householdId  String        @db.Uuid
  invitedEmail String
  invitedRole  HouseholdRole @default(CO_FILER)
  tokenHash    String        @unique
  invitedById  String        @db.Uuid
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime      @default(now())

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedBy    User          @relation("Inviter", fields: [invitedById], references: [id])

  @@index([householdId])
  @@index([invitedEmail])
  @@map("household_invitations")
}

model Dependant {
  id               String    @id @default(uuid()) @db.Uuid
  householdId      String    @db.Uuid
  firstName        String
  lastName         String
  dateOfBirth      DateTime
  relationshipType String    @default("CHILD")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  household        Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("dependants")
}

model TaxYearWorkspace {
  id                  String          @id @default(uuid()) @db.Uuid
  householdId         String          @db.Uuid
  taxYear             Int
  status              WorkspaceStatus @default(DRAFT)
  completionScore     Int             @default(0)
  activeReturnVersion Int             @default(1)
  residenceStatus     TaxResidence    @default(RESIDENT)
  taxClass            TaxClass?
  estimatedTaxBalance Decimal?        @db.Decimal(12, 2)
  calculationResult   Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  household           Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  auditEvents         AuditEvent[]
  documents           Document[]
  extractedFacts      ExtractedFact[]
  confirmedFacts      ConfirmedFact[]
  taxProfile          TaxProfile?
  tasks               MissingInformationItem[]
  returnVersions      ReturnVersion[]
  assessments         Assessment[]
  freelanceProfiles   FreelanceBusinessProfile[]

  @@unique([householdId, taxYear])
  @@index([householdId])
  @@map("tax_year_workspaces")
}

model Document {
  id           String             @id @default(uuid()) @db.Uuid
  workspaceId  String             @db.Uuid
  uploaderId   String             @db.Uuid
  ownerId      String?            @db.Uuid
  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  sha256Hash   String
  storagePath  String
  documentType DocumentType       @default(UNKNOWN)
  status       DocumentStatus     @default(UPLOADED)
  visibility   DocumentVisibility @default(PRIVATE_DRAFT)
  pageCount    Int?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  workspace    TaxYearWorkspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploader     User               @relation("DocumentUploader", fields: [uploaderId], references: [id])
  owner        User?              @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  extractions  DocumentExtraction[]
  extractedFacts ExtractedFact[]
  confirmedFacts ConfirmedFact[]

  @@index([workspaceId])
  @@index([uploaderId])
  @@index([sha256Hash])
  @@map("documents")
}

model DocumentExtraction {
  id            String    @id @default(uuid()) @db.Uuid
  documentId    String    @db.Uuid
  extractedText String    @db.Text
  confidence    Float     @default(1.0)
  rawJson       Json?
  createdAt     DateTime  @default(now())

  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_extractions")
}

model ExtractedFact {
  id            String    @id @default(uuid()) @db.Uuid
  documentId    String    @db.Uuid
  workspaceId   String    @db.Uuid
  ownerId       String?   @db.Uuid
  fieldName     String
  fieldValue    String
  currency      String    @default("EUR")
  confidence    Float     @default(1.0)
  sourcePage    Int?
  sourceSnippet String?
  isConfirmed   Boolean   @default(false)
  confirmedAt   DateTime?
  confirmedById String?   @db.Uuid
  createdAt     DateTime  @default(now())

  document      Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workspace     TaxYearWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  confirmedFact ConfirmedFact?

  @@index([workspaceId])
  @@index([documentId])
  @@map("extracted_facts")
}

model ConfirmedFact {
  id                    String        @id @default(uuid()) @db.Uuid
  workspaceId           String        @db.Uuid
  ownerId               String?       @db.Uuid
  category              FactCategory
  fieldKey              String
  amount                Decimal       @db.Decimal(12, 2)
  currency              String        @default("EUR")
  taxYear               Int
  sourceDocumentId      String?       @db.Uuid
  extractedFactId       String?       @unique @db.Uuid
  isSharedWithHousehold Boolean       @default(true)
  isIncludedInReturn    Boolean       @default(true)
  description           String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  workspace             TaxYearWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner                 User?             @relation("FactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  sourceDocument        Document?         @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  extractedFact         ExtractedFact?    @relation(fields: [extractedFactId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([ownerId])
  @@map("confirmed_facts")
}

model TaxProfile {
  id            String           @id @default(uuid()) @db.Uuid
  workspaceId   String           @unique @db.Uuid
  maritalStatus String           @default("SINGLE")
  answersJson   Json             @default("{}")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  workspace     TaxYearWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("tax_profiles")
}

model MissingInformationItem {
  id                  String           @id @default(uuid()) @db.Uuid
  workspaceId         String           @db.Uuid
  taskType            TaskType
  severity            TaskSeverity     @default(WARNING)
  title               String
  description         String
  isResolved          Boolean          @default(false)
  assignedToUserId    String?          @db.Uuid
  relatedDocumentType DocumentType?
  relatedFactId       String?          @db.Uuid
  createdAt           DateTime         @default(now())
  resolvedAt          DateTime?

  workspace           TaxYearWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("missing_information_items")
}

model ReturnVersion {
  id                     String           @id @default(uuid()) @db.Uuid
  workspaceId            String           @db.Uuid
  versionNumber          Int              @default(1)
  isFrozen               Boolean          @default(false)
  factsSnapshotJson      Json             @default("[]")
  calculationSnapshotJson Json            @default("{}")
  generatedPackageHash   String?
  createdAt              DateTime         @default(now())

  workspace              TaxYearWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  approvals              ReturnApproval[]
  filingPackage          FilingPackage?

  @@unique([workspaceId, versionNumber])
  @@index([workspaceId])
  @@map("return_versions")
}

model ReturnApproval {
  id                String        @id @default(uuid()) @db.Uuid
  returnVersionId   String        @db.Uuid
  userId            String        @db.Uuid
  approvedAt        DateTime      @default(now())
  isSuperseded      Boolean       @default(false)
  supersededAt      DateTime?
  supersedingReason String?

  returnVersion     ReturnVersion @relation(fields: [returnVersionId], references: [id], onDelete: Cascade)
  user              User          @relation("UserReturnApprovals", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([returnVersionId, userId])
  @@index([returnVersionId])
  @@index([userId])
  @@map("return_approvals")
}

model FilingPackage {
  id                 String        @id @default(uuid()) @db.Uuid
  returnVersionId    String        @unique @db.Uuid
  taxYear            Int
  taxClass           TaxClass
  form100BoxesJson   Json          @default("[]")
  myGuichetGuideJson Json          @default("[]")
  packageSha256      String
  generatedAt        DateTime      @default(now())

  returnVersion      ReturnVersion @relation(fields: [returnVersionId], references: [id], onDelete: Cascade)

  @@map("filing_packages")
}

model Assessment {
  id                    String           @id @default(uuid()) @db.Uuid
  workspaceId           String           @db.Uuid
  taxYear               Int
  bulletinDate          DateTime
  assessedTaxableIncome Decimal          @db.Decimal(12, 2)
  assessedTaxDue        Decimal          @db.Decimal(12, 2)
  differenceWithDeclared Decimal         @db.Decimal(12, 2)
  discrepanciesJson     Json             @default("[]")
  createdAt             DateTime         @default(now())

  workspace             TaxYearWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("assessments")
}

model AuditEvent {
  id            String          @id @default(uuid()) @db.Uuid
  householdId   String?         @db.Uuid
  workspaceId   String?         @db.Uuid
  actorId       String          @db.Uuid
  actorEmail    String?
  eventType     AuditEventType
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?
  description   String
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime        @default(now())

  actor         User            @relation("UserAuditEvents", fields: [actorId], references: [id])
  household     Household?      @relation(fields: [householdId], references: [id], onDelete: SetNull)
  workspace     TaxYearWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([householdId, createdAt])
  @@index([actorId])
  @@map("audit_events")
}

model FreelanceBusinessProfile {
  id             String           @id @default(uuid()) @db.Uuid
  workspaceId    String           @db.Uuid
  ownerId        String           @db.Uuid
  businessName   String
  activityType   String
  taxIdOrVat     String?
  accountingType String           @default("CASH_BASIS")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  workspace      TaxYearWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner          User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, ownerId])
  @@index([workspaceId])
  @@index([ownerId])
  @@map("freelance_business_profiles")
}

model CustomAiModel {
  id                 String    @id @db.VarChar(64)
  displayName        String    @map("display_name") @db.VarChar(255)
  providerType       String    @map("provider_type") @db.VarChar(64)
  modelIdentifier    String    @map("model_identifier") @db.VarChar(255)
  endpointUrl        String?   @map("endpoint_url")
  apiKey             String?   @map("api_key")
  capabilities       Json      @default("[]")
  permittedDataClass String    @map("permitted_data_class") @db.VarChar(64)
  hostingRegion      String    @map("hosting_region") @db.VarChar(64)
  status             String    @default("ACTIVE") @db.VarChar(32)
  healthy            Boolean   @default(true)
  isCustom           Boolean   @default(true) @map("is_custom")
  latencyMs          Int?      @default(0) @map("latency_ms")
  lastTestedAt       DateTime? @map("last_tested_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("custom_ai_models")
}

model CustomAiRoute {
  id                      String    @id @db.VarChar(64)
  taskName                String    @unique @map("task_name") @db.VarChar(128)
  primaryModelId          String    @map("primary_model_id") @db.VarChar(64)
  fallbackModelIds        Json      @default("[]") @map("fallback_model_ids")
  promptVersion           String    @map("prompt_version") @db.VarChar(64)
  outputSchemaVersion     String    @map("output_schema_version") @db.VarChar(64)
  timeoutMs               Int       @default(8000) @map("timeout_ms")
  maxDataClass            String    @default("CUSTOMER_DOCUMENT") @map("max_data_class") @db.VarChar(64)
  activeRolloutPercentage Int       @default(100) @map("active_rollout_percentage")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("custom_ai_routes")
}

