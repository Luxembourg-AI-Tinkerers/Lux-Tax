datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum HouseholdRole {
  PRIMARY_FILER
  CO_FILER
  VIEWER
}

enum MembershipStatus {
  PENDING_INVITATION
  ACTIVE
  REMOVED
}

enum WorkspaceStatus {
  DRAFT
  COLLECTING
  NEEDS_REVIEW
  READY_TO_CALCULATE
  CALCULATED
  HOUSEHOLD_REVIEW
  APPROVED
  FILING_PACKAGE_READY
  FILED
  ASSESSED
  CLOSED
}

enum AuditEventType {
  USER_REGISTERED
  USER_LOGGED_IN
  USER_LOGGED_OUT
  HOUSEHOLD_CREATED
  MEMBER_INVITED
  MEMBER_JOINED
  MEMBER_REMOVED
  WORKSPACE_INITIALIZED
  DOCUMENT_UPLOADED
  DOCUMENT_DELETED
  FACT_CREATED
  FACT_CONFIRMED
  FACT_UPDATED
  TAX_CALCULATED
  RETURN_APPROVED
  APPROVAL_INVALIDATED
  FILING_PACKAGE_GENERATED
  RETURN_FILED
  ASSESSMENT_IMPORTED
  ASSESSMENT_FOLLOW_UP_UPDATED
}

enum TaxResidence {
  RESIDENT
  NON_RESIDENT
}

enum TaxClass {
  CLASS_1
  CLASS_1A
  CLASS_2
}

enum FilingRoute {
  MYGUICHET_MANUAL
  PAPER
  OTHER
}

enum DocumentVisibility {
  PRIVATE_DRAFT
  SHARED_FOR_DISCUSSION
  PROPOSED_FOR_RETURN
  INCLUDED_IN_RETURN
  ARCHIVED
}

enum DocumentType {
  SALARY_CERTIFICATE
  PENSION_CERTIFICATE
  MORTGAGE_CERTIFICATE
  INSURANCE_CERTIFICATE
  DONATION_CERTIFICATE
  CHILDCARE_INVOICE
  TAX_ASSESSMENT
  FREELANCE_INVOICE
  BUSINESS_EXPENSE
  PROFIT_AND_LOSS_STATEMENT
  VAT_RETURN
  BUSINESS_TAX_ADVANCE
  FREELANCE_CONTRACT
  UNKNOWN
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  EXTRACTED
  FAILED
  CONFIRMED
}

enum FactCategory {
  EMPLOYMENT_INCOME
  FREELANCE_INCOME
  BUSINESS_EXPENSE
  PENSION_INCOME
  CAPITAL_INCOME
  RENTAL_INCOME
  FOREIGN_INCOME
  MORTGAGE_DEDUCTION
  MORTGAGE_INTEREST
  INSURANCE_DEDUCTION
  PENSION_SAVINGS_111BIS
  SAVINGS_HOUSING
  LRCP_CONTRIBUTION
  DONATION_DEDUCTION
  CHILDCARE_EXPENSE
  HOUSEHOLD_HELP_EXPENSE
  OTHER_DEDUCTION
}

enum TaskSeverity {
  BLOCKER
  WARNING
  INFO
}

enum TaskType {
  MISSING_SALARY_CERTIFICATE
  MISSING_MORTGAGE_CERTIFICATE
  UNCONFIRMED_FACT
  MISSING_SPOUSE_INCOME
  MISSING_RESIDENCE_INFO
  RETURN_APPROVAL_REQUIRED
  MISSING_FREELANCE_DOCUMENT
}

enum NotificationType {
  HOUSEHOLD_INVITATION
  DOCUMENT_CONFIRMATION_REQUIRED
  MATERIAL_FIELD_CHANGED
  MISSING_DOCUMENT
  DEADLINE_REMINDER
  RETURN_READY_FOR_REVIEW
  APPROVAL_REQUESTED
  APPROVAL_INVALIDATED
  FILING_PACKAGE_GENERATED
  ASSESSMENT_FOLLOW_UP
  SECURITY_ALERT
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

model User {
  id               String                @id @default(uuid()) @db.Uuid
  email            String                @unique
  passwordHash     String
  isEmailVerified  Boolean               @default(false)
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  profile          PersonProfile?
  memberships      HouseholdMembership[]
  createdHouseholds Household[]         @relation("HouseholdCreator")
  sentInvitations  HouseholdInvitation[] @relation("Inviter")
  sessions         Session[]
  auditEvents      AuditEvent[]          @relation("UserAuditEvents")
  documentsUploaded Document[]           @relation("DocumentUploader")
  documentsOwned   Document[]           @relation("DocumentOwner")
  confirmedFacts   ConfirmedFact[]       @relation("FactOwner")
  returnApprovals  ReturnApproval[]      @relation("UserReturnApprovals")
  filingRecords    FilingRecord[]        @relation("FilingRecords")
  freelanceProfiles FreelanceBusinessProfile[]
  notifications    Notification[]        @relation("NotificationRecipient")
  notificationsActedOn Notification[]    @relation("NotificationActor")
  notificationPreferences NotificationPreference[]

  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PersonProfile {
  id                 String       @id @default(uuid()) @db.Uuid
  userId             String       @unique @db.Uuid
  firstName          String?
  lastName           String?
  dateOfBirth        DateTime?
  matriculeEncrypted String?
  taxResidence       TaxResidence @default(RESIDENT)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("person_profiles")
}

model Household {
  id          String                @id @default(uuid()) @db.Uuid
  name        String
  slug        String                @unique
  createdById String                @db.Uuid
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  createdBy   User                  @relation("HouseholdCreator", fields: [createdById], references: [id])
  members     HouseholdMembership[]
  invitations HouseholdInvitation[]
  dependants  Dependant[]
  workspaces  TaxYearWorkspace[]
  auditEvents AuditEvent[]
  notifications Notification[]
  notificationPreferences NotificationPreference[]

  @@map("households")
}

model HouseholdMembership {
  id          String           @id @default(uuid()) @db.Uuid
  householdId String           @db.Uuid
  userId      String           @db.Uuid
  role        HouseholdRole    @default(CO_FILER)
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
  @@map("household_memberships")
}

model HouseholdInvitation {
  id           String        @id @default(uuid()) @db.Uuid
  householdId  String        @db.Uuid
  invitedEmail String
  invitedRole  HouseholdRole @default(CO_FILER)
  tokenHash    String        @unique
  invitedById  String        @db.Uuid
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime      @default(now())

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedBy    User          @relation("Inviter", fields: [invitedById], references: [id])

  @@index([householdId])
  @@index([invitedEmail])
  @@map("household_invitations")
}

model Dependant {
  id               String    @id @default(uuid()) @db.Uuid
  householdId      String    @db.Uuid
  firstName        String
  lastName         String
  dateOfBirth      DateTime
  relationshipType String    @default("CHILD")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  household        Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("dependants")
}

/// Append-only history of tax calculations (API-9). `TaxYearWorkspace.calculationResult`
/// keeps the latest result for reads; every calculation also lands here so the
/// trajectory of a return can be audited.
model CalculationSnapshot {
  id                 String       @id @default(uuid()) @db.Uuid
  workspaceId        String       @db.Uuid
  taxYear            Int
  taxClass           TaxClass
  rulePackageVersion String
  /// SHA-256 of the canonical JSON of `resultJson`.
  resultSha256       String
  resultJson         Json
  createdById        String?      @db.Uuid
  createdAt          DateTime     @default(now())

  workspace          TaxYearWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("calculation_snapshots")
}

model TaxYearWorkspace {
  id                  String          @id @default(uuid()) @db.Uuid
  householdId         String          @db.Uuid
  taxYear             Int
  status              WorkspaceStatus @default(DRAFT)
  completionScore     Int             @default(0)
  activeReturnVersion Int             @default(1)
  residenceStatus     TaxResidence    @default(RESIDENT)
  taxClass            TaxClass?
  estimatedTaxBalance Decimal?        @db.Decimal(12, 2)
  calculationResult   Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  household           Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  auditEvents         AuditEvent[]
  documents           Document[]
  extractedFacts      ExtractedFact[]
  confirmedFacts      ConfirmedFact[]
  taxProfile          TaxProfile?
  tasks               MissingInformationItem[]
  returnVersions      ReturnVersion[]
  filingRecord        FilingRecord?
  assessments         Assessment[]
  freelanceProfiles   FreelanceBusinessProfile[]
  notifications       Notification[]
  calculationSnapshots CalculationSnapshot[]

  @@unique([householdId, taxYear])
  @@index([householdId])
  @@map("tax_year_workspaces")
}

model Document {
  id           String             @id @default(uuid()) @db.Uuid
  workspaceId  String             @db.Uuid
  uploaderId   String             @db.Uuid
  ownerId      String?            @db.Uuid
  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  sha256Hash   String
  storagePath  String
  documentType DocumentType       @default(UNKNOWN)
  status       DocumentStatus     @default(UPLOADED)
  visibility   DocumentVisibility @default(PRIVATE_DRAFT)
  pageCount    Int?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  workspace    TaxYearWorkspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploader     User               @relation("DocumentUploader", fields: [uploaderId], references: [id])
  owner        User?              @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  extractions  DocumentExtraction[]
  extractedFacts ExtractedFact[]
  confirmedFacts ConfirmedFact[]

  @@index([workspaceId])
  @@index([uploaderId])
  @@index([sha256Hash])
  @@map("documents")
}

model DocumentExtraction {
  id            String    @id @default(uuid()) @db.Uuid
  documentId    String    @db.Uuid
  extractedText String    @db.Text
  confidence    Float     @default(1.0)
  rawJson       Json?
  createdAt     DateTime  @default(now())

  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_extractions")
}

model ExtractedFact {
  id            String    @id @default(uuid()) @db.Uuid
  documentId    String    @db.Uuid
  workspaceId   String    @db.Uuid
  ownerId       String?   @db.Uuid
  fieldName     String
  fieldValue    String
  currency      String    @default("EUR")
  confidence    Float     @default(1.0)
  sourcePage    Int?
  sourceSnippet String?
  isConfirmed   Boolean   @default(false)
  confirmedAt   DateTime?
  confirmedById String?   @db.Uuid
  createdAt     DateTime  @default(now())

  document      Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workspace     TaxYearWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  confirmedFact ConfirmedFact?

  @@index([workspaceId])
  @@index([documentId])
  @@map("extracted_facts")
}

model ConfirmedFact {
  id                    String        @id @default(uuid()) @db.Uuid
  workspaceId           String        @db.Uuid
  ownerId               String?       @db.Uuid
  category              FactCategory
  fieldKey              String
  amount                Decimal       @db.Decimal(12, 2)
  currency              String        @default("EUR")
  taxYear               Int
  sourceDocumentId      String?       @db.Uuid
  extractedFactId       String?       @unique @db.Uuid
  isSharedWithHousehold Boolean       @default(true)
  isIncludedInReturn    Boolean       @default(true)
  description           String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  workspace             TaxYearWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner                 User?             @relation("FactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  sourceDocument        Document?         @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  extractedFact         ExtractedFact?    @relation(fields: [extractedFactId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([ownerId])
  @@map("confirmed_facts")
}

model TaxProfile {
  id            String           @id @default(uuid()) @db.Uuid
  workspaceId   String           @unique @db.Uuid
  maritalStatus String           @default("SINGLE")
  answersJson   Json             @default("{}")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  workspace     TaxYearWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("tax_profiles")
}

model MissingInformationItem {
  id                  String           @id @default(uuid()) @db.Uuid
  workspaceId         String           @db.Uuid
  taskType            TaskType
  severity            TaskSeverity     @default(WARNING)
  title               String
  description         String
  isResolved          Boolean          @default(false)
  assignedToUserId    String?          @db.Uuid
  relatedDocumentType DocumentType?
  relatedFactId       String?          @db.Uuid
  createdAt           DateTime         @default(now())
  resolvedAt          DateTime?

  workspace           TaxYearWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("missing_information_items")
}

model ReturnVersion {
  id                     String           @id @default(uuid()) @db.Uuid
  workspaceId            String           @db.Uuid
  versionNumber          Int              @default(1)
  isFrozen               Boolean          @default(false)
  factsSnapshotJson      Json             @default("[]")
  calculationSnapshotJson Json            @default("{}")
  generatedPackageHash   String?
  createdAt              DateTime         @default(now())

  workspace              TaxYearWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  approvals              ReturnApproval[]
  filingPackage          FilingPackage?
  filingRecord           FilingRecord?

  @@unique([workspaceId, versionNumber])
  @@index([workspaceId])
  @@map("return_versions")
}

model ReturnApproval {
  id                String        @id @default(uuid()) @db.Uuid
  returnVersionId   String        @db.Uuid
  userId            String        @db.Uuid
  approvedAt        DateTime      @default(now())
  isSuperseded      Boolean       @default(false)
  supersededAt      DateTime?
  supersedingReason String?

  returnVersion     ReturnVersion @relation(fields: [returnVersionId], references: [id], onDelete: Cascade)
  user              User          @relation("UserReturnApprovals", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([returnVersionId, userId])
  @@index([returnVersionId])
  @@index([userId])
  @@map("return_approvals")
}

model FilingPackage {
  id                 String        @id @default(uuid()) @db.Uuid
  returnVersionId    String        @unique @db.Uuid
  taxYear            Int
  taxClass           TaxClass
  form100BoxesJson   Json          @default("[]")
  annexesJson        Json          @default("[]")
  myGuichetGuideJson Json          @default("[]")
  /// Certificate-160 codes that could not be mapped; kept so the warning
  /// survives a page reload instead of vanishing with the generated response.
  unsupportedCodesJson Json        @default("[]")
  packageSha256      String
  /// Append-only evidence index: { sha256, generatedAt, supersededAt? }[]. The last
  /// entry without supersededAt is the package currently in force (API-7).
  historyJson        Json          @default("[]")
  generatedAt        DateTime      @default(now())

  returnVersion      ReturnVersion @relation(fields: [returnVersionId], references: [id], onDelete: Cascade)

  @@map("filing_packages")
}

/// The user's declaration that the return was actually submitted. Exactly one
/// per workspace: the first filing freezes the version; a correction needs an
/// amendment (a new ReturnVersion), never a second record on the same one.
model FilingRecord {
  id                    String        @id @default(uuid()) @db.Uuid
  workspaceId           String        @unique @db.Uuid
  returnVersionId       String        @unique @db.Uuid
  filedAt               DateTime
  route                 FilingRoute   @default(MYGUICHET_MANUAL)
  confirmationReference String?
  notes                 String?
  createdById           String        @db.Uuid
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  workspace             TaxYearWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  returnVersion         ReturnVersion    @relation(fields: [returnVersionId], references: [id], onDelete: Restrict)
  createdBy             User             @relation("FilingRecords", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@map("filing_records")
}

model Assessment {
  id                    String           @id @default(uuid()) @db.Uuid
  workspaceId           String           @db.Uuid
  taxYear               Int
  bulletinDate          DateTime
  assessedTaxableIncome Decimal          @db.Decimal(12, 2)
  assessedTaxDue        Decimal          @db.Decimal(12, 2)
  differenceWithDeclared Decimal         @db.Decimal(12, 2)
  discrepanciesJson     Json             @default("[]")
  /// Date the ACD notice was received (equal to the bulletin date on import).
  receivedAt            DateTime?
  /// Last day to lodge an objection against this assessment.
  objectionDeadline     DateTime?
  /// Internal reminder to check the file with the ACD.
  followUpAt            DateTime?
  /// True once the assessment is final (no objection lodged / window closed).
  isFinal               Boolean          @default(false)
  createdAt             DateTime         @default(now())

  workspace             TaxYearWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("assessments")
}

model AuditEvent {
  id            String          @id @default(uuid()) @db.Uuid
  householdId   String?         @db.Uuid
  workspaceId   String?         @db.Uuid
  actorId       String          @db.Uuid
  actorEmail    String?
  eventType     AuditEventType
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?
  description   String
  ipAddress     String?
  userAgent     String?
  /// API-10: hash chain. `prevHash` is the previous event's `hash` for the same
  /// household; `hash` covers this event's canonical form plus `prevHash`.
  prevHash      String?
  hash          String?
  createdAt     DateTime        @default(now())

  actor         User            @relation("UserAuditEvents", fields: [actorId], references: [id])
  household     Household?      @relation(fields: [householdId], references: [id], onDelete: SetNull)
  workspace     TaxYearWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([householdId, createdAt])
  @@index([householdId, hash])
  @@index([actorId])
  @@map("audit_events")
}

model FreelanceBusinessProfile {
  id             String           @id @default(uuid()) @db.Uuid
  workspaceId    String           @db.Uuid
  ownerId        String           @db.Uuid
  businessName   String
  activityType   String
  taxIdOrVat     String?
  accountingType String           @default("CASH_BASIS")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  workspace      TaxYearWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner          User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, ownerId])
  @@index([workspaceId])
  @@index([ownerId])
  @@map("freelance_business_profiles")
}

model CustomAiModel {
  id                 String    @id @db.VarChar(64)
  displayName        String    @map("display_name") @db.VarChar(255)
  providerType       String    @map("provider_type") @db.VarChar(64)
  modelIdentifier    String    @map("model_identifier") @db.VarChar(255)
  endpointUrl        String?   @map("endpoint_url")
  apiKey             String?   @map("api_key")
  capabilities       Json      @default("[]")
  permittedDataClass String    @map("permitted_data_class") @db.VarChar(64)
  hostingRegion      String    @map("hosting_region") @db.VarChar(64)
  status             String    @default("ACTIVE") @db.VarChar(32)
  healthy            Boolean   @default(true)
  isCustom           Boolean   @default(true) @map("is_custom")
  latencyMs          Int?      @default(0) @map("latency_ms")
  lastTestedAt       DateTime? @map("last_tested_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("custom_ai_models")
}

model CustomAiRoute {
  id                      String    @id @db.VarChar(64)
  taskName                String    @unique @map("task_name") @db.VarChar(128)
  primaryModelId          String    @map("primary_model_id") @db.VarChar(64)
  fallbackModelIds        Json      @default("[]") @map("fallback_model_ids")
  promptVersion           String    @map("prompt_version") @db.VarChar(64)
  outputSchemaVersion     String    @map("output_schema_version") @db.VarChar(64)
  timeoutMs               Int       @default(8000) @map("timeout_ms")
  maxDataClass            String    @default("CUSTOMER_DOCUMENT") @map("max_data_class") @db.VarChar(64)
  activeRolloutPercentage Int       @default(100) @map("active_rollout_percentage")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("custom_ai_routes")
}

model Notification {
  id          String               @id @default(uuid()) @db.Uuid
  householdId String               @db.Uuid
  workspaceId String?              @db.Uuid
  userId      String               @db.Uuid
  /** Idempotency key: a repeat emission for the same user is ignored. */
  dedupeKey   String?              @db.VarChar(200)
  actorId     String?              @db.Uuid
  type        NotificationType
  severity    NotificationSeverity @default(INFO)
  title       String
  body        String
  entityType  String?
  entityId    String?
  actionUrl   String?
  isRead      Boolean              @default(false)
  readAt      DateTime?
  createdAt   DateTime             @default(now())

  user        User              @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor       User?             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  household   Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  workspace   TaxYearWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries  NotificationDelivery[]

  @@unique([userId, dedupeKey])
  @@index([userId, isRead, createdAt])
  @@index([workspaceId, createdAt])
  @@map("notifications")
}

enum NotificationChannel {
  EMAIL
  PUSH
}

enum NotificationDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

/// Transactional outbox: one row per notification and channel. The worker
/// claims due rows, calls the channel adapter, and reschedules with exponential
/// backoff until the attempt budget is exhausted.
model NotificationDelivery {
  id             String                     @id @default(uuid()) @db.Uuid
  notificationId String                     @db.Uuid
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  attempts       Int                        @default(0)
  nextAttemptAt  DateTime                   @default(now())
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
  @@map("notification_deliveries")
}

model NotificationPreference {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @db.Uuid
  householdId  String             @db.Uuid
  emailEnabled Boolean            @default(true)
  pushEnabled  Boolean            @default(true)
  mutedTypes   NotificationType[] @default([])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
  @@map("notification_preferences")
}

