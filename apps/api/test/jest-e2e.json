{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "extensionsToTreatAsEsm": [
    ".ts"
  ],
  "transform": {
    "^.+\\.tsx?$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": {
          "module": "NodeNext",
          "moduleResolution": "NodeNext",
          "target": "ES2022",
          "experimentalDecorators": true,
          "emitDecoratorMetadata": true,
          "esModuleInterop": true,
          "skipLibCheck": true,
          "strict": true,
          "strictNullChecks": true,
          "noImplicitAny": false,
          "types": [
            "node",
            "jest"
          ]
        }
      }
    ]
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "testTimeout": 30000,
  "moduleDirectories": [
    "node_modules",
    "<rootDir>/../../../tmp/flat/node_modules"
  ]
}
