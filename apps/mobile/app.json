{
  "expo": {
    "name": "Luxembourg Tax Workspace",
    "slug": "luxtax-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0284c7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "lu.luxtax.workspace"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "lu.luxtax.workspace"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "scheme": "luxtax"
  }
}
