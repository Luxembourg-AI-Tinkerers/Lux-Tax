{
  "extends": "./tsconfig.test.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@luxtax/contracts": [
        "packages/contracts/src/index.ts"
      ],
      "@luxtax/tax-engine": [
        "packages/tax-engine/src/index.ts"
      ],
      "@luxtax/api-client": [
        "packages/api-client/src/index.ts"
      ],
      "@luxtax/design-tokens": [
        "packages/design-tokens/src/index.ts"
      ],
      "react": [
        "apps/web/node_modules/react"
      ],
      "react/jsx-runtime": [
        "apps/web/node_modules/react/jsx-runtime"
      ],
      "react/jsx-dev-runtime": [
        "apps/web/node_modules/react/jsx-dev-runtime"
      ],
      "react-test-renderer": [
        "apps/web/node_modules/react-test-renderer"
      ],
      "next/navigation": [
        "apps/web/test/support/next-navigation-shim.ts"
      ],
      "zod": [
        ".tools/node_modules/zod"
      ]
    }
  },
  "include": [
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx",
    "apps/web/test/**/*.ts",
    "apps/web/test/**/*.tsx"
  ]
}
