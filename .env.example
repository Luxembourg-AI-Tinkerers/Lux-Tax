# ---------------------------------------------------------------------------
# Required. The API refuses to start when either is missing: a signing key with
# a default is a key everybody has.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/luxtax?schema=public"
# At least 32 characters. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
PORT=3001
# Required in production, and must be https there: it is the base of the e-mail
# verification link and the default CORS origin.
FRONTEND_URL="http://localhost:3000"
# Browser origins allowed to call the API, comma-separated. Defaults to
# FRONTEND_URL. Add a LAN address to demo from a phone, e.g.
# CORS_ORIGINS="http://localhost:3000,http://192.168.0.195:3000"
# Every entry must be https in production.
CORS_ORIGINS=
NODE_ENV="development"
REDIS_URL="redis://localhost:6380"

# Platform administration: comma-separated allowlist. Fails closed when unset.
# An account must also have a VERIFIED e-mail address to use it.
ADMIN_EMAILS=

# --- Rate limiting ---------------------------------------------------------
# On by default. Set to "false" only for a controlled load test.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_CAPACITY=60
RATE_LIMIT_IP_REFILL=1
RATE_LIMIT_USER_CAPACITY=120
RATE_LIMIT_USER_REFILL=2

# --- Proxy trust (L6) ------------------------------------------------------
# X-Forwarded-For is client-controlled. Leave this unset when the API is
# reachable directly: the recorded client address is then the socket address.
# Set it only when a proxy is genuinely in front, and prefer the narrowest
# form: a hop count (TRUST_PROXY=1 for one load balancer) or the proxy's
# networks (TRUST_PROXY=10.0.0.0/8). TRUST_PROXY=true trusts the header
# unconditionally and is only correct when every request comes through that
# proxy. An unreadable value falls back to no trust.
# TRUST_PROXY=1

# --- Multi-factor authentication -------------------------------------------
# Per account, not per deployment: a user enrols at POST /api/auth/mfa/enrol and
# confirms with /mfa/activate. There is no global switch to leave off.
# The TOTP seed is sealed with a key derived from JWT_ACCESS_SECRET.

# --- Diagnostics -----------------------------------------------------------
# 5xx responses are generic by default. Set to "true" only on a machine you
# control: it re-enables internal error text (never for database errors).
EXPOSE_ERROR_DETAILS=false
# Prisma prints bound parameter values (e-mails, amounts, token hashes) when on.
PRISMA_LOG_QUERIES=false

# Notification outbox — delivery polling (off unless NOTIFICATION_OUTBOX_ENABLED=true)
NOTIFICATION_OUTBOX_ENABLED=false
NOTIFICATION_OUTBOX_INTERVAL_MS=60000

# --- E-mail delivery -------------------------------------------------------
# SMTP_HOST unset -> messages go to the local JSONL sink under
# tmp/notifications/email.jsonl (a real transport, nothing leaves the machine).
# SMTP_HOST set   -> the real SMTP client is used: STARTTLS on 587 by default,
# implicit TLS on 465 with SMTP_SECURE=true.
# The verification e-mail uses this same transport.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
# Refuse to send credentials over a plaintext connection.
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=
# Envelope sender; defaults to SMTP_USER.
SMTP_FROM=
SMTP_TIMEOUT_MS=20000
NOTIFICATION_EMAIL_SINK=

# --- Push delivery ---------------------------------------------------------
# A device registers through POST /api/workspaces/:id/notifications/devices and
# the Expo transport picks it up at startup; no flag is needed.
NOTIFICATION_PUSH_ENABLED=false
NOTIFICATION_PUSH_SINK=
# Expo access token (only when the project requires one) and an endpoint
# override for a proxy or a test server.
EXPO_ACCESS_TOKEN=
EXPO_PUSH_ENDPOINT=

# --- Model credentials -----------------------------------------------------
# Encrypts third-party model API keys at rest (AES-256-GCM). 32 bytes, hex.
# Generate with: openssl rand -hex 32
MODEL_KEY_ENCRYPTION_KEY=

# Deadline reminders — objection-window sweep (off unless enabled)
NOTIFICATION_REMINDERS_ENABLED=false
NOTIFICATION_REMINDERS_INTERVAL_MS=21600000

# --- Local OCR ------------------------------------------------------------
# Path to the Tesseract executable. When it is set and the file exists, an
# uploaded photo or scan is read in-process, with no model endpoint and no
# network call. Unset means NOT_CONFIGURED: the document is stored and marked
# as needing OCR instead of silently producing no figures.
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_TESSERACT_PATH=
# Tesseract language pack(s) and page-segmentation mode. 6 = a uniform block
# of text, which is what a photographed certificate is.
OCR_LANGUAGES=fra
OCR_PSM=6
