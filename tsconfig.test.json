{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "experimentalDecorators": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "typeRoots": [
      "./.tools/node_modules/@types"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@luxtax/contracts": [
        "packages/contracts/src/index.ts"
      ],
      "@luxtax/tax-engine": [
        "packages/tax-engine/src/index.ts"
      ],
      "@luxtax/api-client": [
        "packages/api-client/src/index.ts"
      ],
      "@luxtax/design-tokens": [
        "packages/design-tokens/src/index.ts"
      ],
      "react-native": [
        ".tools/rn-shim/index.js"
      ],
      "zod": [
        ".tools/node_modules/zod"
      ],
      "react": [
        ".tools/node_modules/react"
      ],
      "react-test-renderer": [
        ".tools/node_modules/react-test-renderer"
      ]
    }
  },
  "include": [
    "packages/contracts/src/**/*.ts",
    "packages/validation/src/**/*.ts",
    "packages/validation/test/**/*.ts",
    "packages/tax-engine/src/**/*.ts",
    "packages/tax-engine/test/**/*.ts",
