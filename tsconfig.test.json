{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "typeRoots": ["./.tools/node_modules/@types"],
    "types": ["node"],
    "paths": {
      "@luxtax/contracts": ["packages/contracts/src/index.ts"],
      "@luxtax/tax-engine": ["packages/tax-engine/src/index.ts"],
      "@luxtax/api-client": ["packages/api-client/src/index.ts"],
      "@luxtax/design-tokens": ["packages/design-tokens/src/index.ts"],
      "react-native": [".tools/rn-shim/index.js"],
      "zod": [".tools/node_modules/zod"]
    }
  },
  "include": [
    "packages/contracts/src/**/*.ts",
    "packages/validation/src/**/*.ts",
    "packages/validation/test/**/*.ts",
    "packages/tax-engine/src/**/*.ts",
    "packages/tax-engine/test/**/*.ts",
    "apps/api/src/modules/filing/annex-pdf.builder.ts",
    "apps/api/src/modules/filing/form100-case-map.ts",
    "apps/api/src/modules/filing/return-version-history.ts",
    "apps/api/src/modules/filing/assessment-dates.ts",
    "apps/api/src/modules/facts/fact-visibility.ts",
    "apps/api/src/modules/calculations/class-resolution.ts",
    "apps/api/test/class-resolution.spec.ts",
    "apps/api/src/common/auth/platform-admin.ts",
    "apps/api/src/modules/notifications/notification-rules.ts",
    "apps/api/test/annex-pdf.spec.ts",
    "apps/api/test/filing-year-guard.spec.ts",
    "apps/api/test/filing-package-evidence.spec.ts",
    "apps/api/test/calculation-history.spec.ts",
    "apps/api/test/audit-chain.spec.ts",
    "apps/api/test/rate-limit.spec.ts",
    "apps/api/test/mfa-totp.spec.ts",
    "apps/web/src/lib/fact-inclusion.ts",
    "apps/web/test/fact-inclusion.spec.ts",
    "apps/web/src/components/TaxCalculatorView.tsx",
    "apps/web/test/tax-calculator-view.spec.ts",
    "apps/web/src/components/QuestionnaireView.tsx",
    "apps/web/test/questionnaire-view.spec.ts",
    "packages/design-tokens/src/translations.ts",
    "packages/design-tokens/test/translations.spec.ts",
    "apps/mobile/src/lib/workspace.ts",
    "apps/mobile/test/workspace.spec.ts",
    "apps/mobile/test/client-methods.spec.ts",
    "apps/mobile/src/lib/offline-queue.ts",
    "apps/mobile/test/offline-queue.spec.ts",
    "apps/mobile/src/lib/queue-runtime.ts",
    "apps/mobile/test/queue-runtime.spec.ts",
    "apps/mobile/src/lib/privacy.ts",
    "apps/mobile/test/privacy.spec.ts",
    "apps/mobile/src/lib/package-download.ts",
    "apps/mobile/test/package-download.spec.ts",
    "apps/mobile/src/lib/push-and-status.ts",
    "apps/mobile/test/push-and-status.spec.ts",
    "apps/mobile/src/lib/deep-links.ts",
    "apps/mobile/test/deep-links.spec.ts",
    "apps/mobile/src/lib/app-lock.ts",
    "apps/mobile/test/app-lock.spec.ts",
    "apps/mobile/src/lib/file-export.ts",
    "apps/mobile/test/file-export.spec.ts",
    "apps/api/test/platform-admin.spec.ts",
    "apps/api/test/fact-visibility.spec.ts",
    "apps/api/test/form100-case-map.spec.ts",
    "apps/api/test/notification-rules.spec.ts",
    "apps/api/test/return-version-history.spec.ts",
    "apps/api/test/assessment-dates.spec.ts"
  ]
}
