{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "typeRoots": ["./.tools/node_modules/@types"],
    "types": ["node"],
    "paths": {
      "@luxtax/contracts": ["packages/contracts/src/index.ts"],
      "@luxtax/validation": ["packages/validation/src/index.ts"],
      "@luxtax/tax-engine": ["packages/tax-engine/src/index.ts"]
    }
  },
  "include": [
    "packages/contracts/src/**/*.ts",
    "packages/validation/src/**/*.ts",
    "packages/tax-engine/src/**/*.ts",
    "apps/api/src/modules/calculations/**/*.ts",
    "apps/api/src/modules/filing/**/*.ts",
    "apps/api/src/modules/freelance/**/*.ts"
  ]
}
